</BaseLayout>

<style>
  .citation {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  h2 {
    border-left: 3px solid var(--color-accent);
    padding-left: 0.6em;
  }
</style>
