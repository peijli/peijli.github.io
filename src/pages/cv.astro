  <ul>
    {
      coursework.map((entry) => (
        <li>
          <a href={`/academics/${entry.id}/`}>{entry.data.title}</a>
          <span class="citation"> — {entry.data.type}, {entry.data.venue}</span>
        </li>
      ))
    }
  </ul>

  <h2>Service &amp; Leadership</h2>

  <ul>
    <li>
      <strong>Props &amp; Uniforms Staff</strong>, Leland Stanford Junior University Marching Band, Stanford, CA
      (March 2025 &ndash; Present)
    </li>
    <li>
      <strong>Undergraduate Student Member</strong>, Tau Beta Pi Engineering Honor Society, Michigan Gamma
