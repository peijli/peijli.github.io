  </ul>

  <h2>Projects</h2>

  <ul>
    {
      flagship.map((entry) => (
        <li>
          <a href={`/projects/${entry.id}/`}>{entry.data.title}</a>
          <span class="citation"> — {entry.data.type}</span>
        </li>
      ))
    }
  </ul>

  <h2>Publications</h2>

  <ul>
    {
      research.map((entry) => (
        <li>
