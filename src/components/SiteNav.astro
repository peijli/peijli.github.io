---
import { siteTitle } from '../data/profile';
import { navItems } from '../data/navigation';

const currentPath = Astro.url.pathname;
---

<header class="site-nav">
  <nav>
    <a class="site-title" href="/">{siteTitle}</a>
    <ul class="nav-links">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[{ active: currentPath.startsWith(item.href) }]}
            >
              {item.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-nav {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: calc(var(--max-width) + 260px);
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
  }

  .site-title {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-title:hover {
    text-decoration: none;
    color: var(--color-link);
  }

  .nav-links {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--color-link);
  }
</style>
